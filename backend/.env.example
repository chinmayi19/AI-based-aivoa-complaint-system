# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_EXTRACTION_MODEL=gemma2-9b-it
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# --- Database ---
# Postgres example:
# DATABASE_URL=postgresql+psycopg2://aivoa:aivoa@localhost:5432/aivoa_complaints
# SQLite fallback for quick local your_groq_api_key_hereruns without Docker:
DATABASE_URL=sqlite:///./aivoa_complaints.db

# --- App ---
CORS_ORIGINS=http://localhost:3000
